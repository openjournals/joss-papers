              <th align="right"><inline-formula><alternatives>
              <tex-math><![CDATA[k_\ell]]></tex-math>
              <mml:math display="inline" xmlns:mml="http://www.w3.org/1998/Math/MathML"><mml:msub><mml:mi>k</mml:mi><mml:mi>ℓ</mml:mi></mml:msub></mml:math></alternatives></inline-formula></th>
              <th align="left">Reference</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td align="left">1d</td>
              <td align="left"><monospace>Segment</monospace></td>
              <td align="right">23</td>
              <td align="right">13</td>
              <td align="left">(<xref alt="Laurie, 1997" rid="ref-Laurie1997" ref-type="bibr">Laurie,
              1997</xref>)</td>
            </tr>
            <tr>
              <td align="left">2d</td>
              <td align="left"><monospace>Triangle</monospace></td>
              <td align="right">8</td>
