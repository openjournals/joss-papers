          <th align="right">Speed-up</th>
          <th align="right">DataSplits.jl (GiB)</th>
          <th align="right">astartes (GiB)</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td align="left">Kennard–Stone</td>
          <td align="right">10,000</td>
          <td align="right">389</td>
          <td align="right">1,126</td>
